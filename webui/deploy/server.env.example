YDFS_ORIGIN=https://build.example.org:8088
YDFS_ALLOWED_USERS=your-github-username,teammate
YDFS_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional: the AI Code Assistant's provider credential. Set here and it wins
# over anything configured through the page, and never touches the database.
#YDFS_AI_API_KEY=REPLACE_WITH_THE_PROVIDER_API_KEY
