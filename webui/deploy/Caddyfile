https://{$YDFS_DOMAIN}:8088 {
    bind 0.0.0.0
    route {
        # Never accept identity or trust headers supplied by a browser.
        request_header -X-Forwarded-User
        request_header -X-Auth-Request-User
        request_header -X-Build-Proxy-Secret
        handle /oauth2/* {
            reverse_proxy 127.0.0.1:4180
        }
        handle {
            forward_auth 127.0.0.1:4180 {
                uri /oauth2/auth
                copy_headers X-Auth-Request-User>X-Forwarded-User
                @login status 401
                handle_response @login {
                    redir /oauth2/start?rd=https://{$YDFS_DOMAIN}:8088/ 302
                }
            }
            reverse_proxy 127.0.0.1:8080 {
                header_up X-Build-Proxy-Secret {$YDFS_PROXY_SECRET}
                flush_interval -1
            }
        }
    }
}
