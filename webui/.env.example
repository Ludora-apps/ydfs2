# Absolute physical paths (no symlinks); data must be outside the checkout.
YDFS_REPO=/opt/ydfs2
YDFS_DATA=/var/lib/ydfs-web
YDFS_DOMAIN=build.example.org
YDFS_ALLOWED_USERS=your-github-username
# openssl rand -hex 32
YDFS_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Required for --profile public:
OAUTH2_PROXY_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_APP_ID
OAUTH2_PROXY_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_APP_SECRET
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
